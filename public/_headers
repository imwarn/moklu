# Moklu — static response headers
#
# Format: Cloudflare Pages / Netlify compatible.
# NOTE: this file is a single source of truth reused by scripts/serve-headers.mjs,
# scripts/sync-cf-headers.mjs, and workers/telemetry/src/headersPolicy.ts so the CSP,
# security headers, and cache rules below are exercised in CI before reaching production.
#
# CSP design constraints measured from the app itself:
#   - script-src allows static.cloudflareinsights.com: privacy-first cookie-free Cloudflare Web Analytics beacon
#   - style-src needs 'unsafe-inline': 33 components use React `style={{...}}`
#   - style-src needs fonts.googleapis.com: src/utils/fonts.ts injects <link> at runtime
#   - font-src needs data:: user-uploaded fonts are registered from data URLs
#   - connect-src allows the three direct AI providers plus cloudflareinsights.com for Web Analytics beacons
#   - script-src allows 'wasm-unsafe-eval': local HEIC WASM decoding (strictly zero JS eval/new Function)
#   - no 'unsafe-eval' or 'unsafe-inline' in script-src: the bundle contains no eval/new Function or inline scripts

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cache-Control: public, no-cache
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self' https://api.openai.com https://openrouter.ai https://generativelanguage.googleapis.com https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# HTML entry documents use `public, no-cache` (never `no-store`) so browsers preserve
# Back-Forward Cache (bfcache) while always revalidating ETag on deploys, paired with
# short-lived edge CDN caching and stale-while-revalidate.
/
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, no-cache
  CDN-Cache-Control: public, s-maxage=60, stale-while-revalidate=86400

/index.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, no-cache
  CDN-Cache-Control: public, s-maxage=60, stale-while-revalidate=86400

# Lightweight healthcheck endpoints must never be cached by proxies or CDNs.
/healthz.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-store

/healthz
  Content-Type: text/html; charset=utf-8
  Cache-Control: no-store

/healthz/
  Content-Type: text/html; charset=utf-8
  Cache-Control: no-store

/healthz/index.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: no-store

# IndexNow ownership verification key file.
/fb6946466b9027e3bbb1506815e0f52e.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400
  CDN-Cache-Control: public, s-maxage=86400
  X-Content-Type-Options: nosniff

# Content-hashed bundles are immutable: the bytes change only when the name does.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000, immutable

# Unhashed public static and crawler files get a short TTL so updates propagate cleanly.
/logo.svg
